# Response headers for hosts that read this file (Cloudflare Pages, Netlify). GitHub Pages ignores
# it, which is why the page also refuses to run in a frame from the inside.
#
# Any other host: send the same three, e.g. in nginx
#   add_header Content-Security-Policy "frame-ancestors 'none'" always;
#   add_header X-Frame-Options DENY always;
#   add_header X-Content-Type-Options nosniff always;
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
